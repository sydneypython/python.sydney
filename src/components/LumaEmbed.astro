---

import Heading from "./Heading.astro";
---
<div class="flex flex-col space-y-5 items-center justify-center p-5">
  <div class="flex flex-col space-y-5 w-full items-start">
    <Heading level={2} >Upcoming Events</Heading>
  </div>
  <iframe
    src="https://luma.com/embed/calendar/cal-1M8G1dRAdSuJPhi/events?lt=light"
    width="100%"
    height="450"
    frameborder="0"
    style="border: 1px solid #bfcbda88; border-radius: 4px;"
    aria-hidden="false"
    tabindex="0"
  ></iframe>
</div>
<div class="flex flex-col space-y-5 items-center justify-center p-5">
  <div class="flex flex-col space-y-5 w-full items-start">
    <Heading level={2} >Past Events</Heading>
  </div>
  <div class="flex flex-col w-full items-center justify-center">
    <p class="text-sm text-gray-600 mt-2 text-center">
      Head over to our
      <a href="https://luma.com/sydneypython?period=past" class="underline hover:no-underline">Luma calendar</a>
      to see all our past events.</p>
  </div>
</div>